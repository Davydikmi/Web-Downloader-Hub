@{
    ViewData["Title"] = "Главная";
}
<link rel="stylesheet" href="~/css/mainStyle.css" asp-append-version="true" />

<div class="container mt-4">
    <!-- Header -->
    <div class="topbar mb-4">
        <h2>Web Downloader Hub</h2>
        <div>
            <a class="btn btn-secondary me-2" href="/Home/Index">Главная</a>
            <a class="btn btn-secondary" href="/History/Index">История</a>
        </div>
    </div>

    <!-- Input form -->
    <form id="downloadForm" class="form-inline mb-3">
        <input type="text" id="urlInput" class="form-control" placeholder="Введите ссылку..." required />
        <button class="btn btn-primary" type="submit">Добавить</button>
    </form>

    <!-- Ошибка -->
    <div id="errorContainer"></div>

    <!-- Список файлов -->
    <div id="fileList"></div>

    <!-- Buttons -->
    <div class="mb-3 d-flex gap-2 flex-wrap">
        <button class="btn btn-danger" id="clearListBtn">Очистить</button>
        <button class="btn btn-success" id="downloadBtn">Скачать</button>
        <!-- </> <button class="btn btn-info" id="qrBtn">Скачать по QR</button> ЗАМОРОЖЕНО НА ДОЛГОСТРОЙ -->
    </div>
</div>

<script src="~/js/mainScript.js" asp-append-version="true"></script>